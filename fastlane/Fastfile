default_platform(:ios)

platform :ios do
  desc "Build and upload a release build to TestFlight"
  lane :testflight do
    required_env_vars = %w[
      APP_IDENTIFIER
      APPLE_TEAM_ID
      APP_STORE_CONNECT_API_KEY_ID
      APP_STORE_CONNECT_API_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_P8
    ]

    required_env_vars.each do |key|
      UI.user_error!("#{key} is required") if ENV[key].to_s.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      in_house: false
    )

    build_app(
      workspace: "Delta.xcworkspace",
      scheme: "Delta",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Delta.ipa",
      export_team_id: ENV["APPLE_TEAM_ID"],
      clean: true,
      xcargs: [
        "-allowProvisioningUpdates",
        "DEVELOPMENT_TEAM=#{ENV["APPLE_TEAM_ID"]}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{ENV["APP_IDENTIFIER"]}",
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
